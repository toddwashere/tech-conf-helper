# Elasticsearch (values from ~/elastic-start-local/.env after running start-local)
ES_URL=http://localhost:9200
ES_API_KEY=
ES_USERNAME=elastic
ES_PASSWORD=
# Optional: override the embedding endpoint used by semantic_text fields
# ES_INFERENCE_ID=.elser-2-elasticsearch

# AI features (summaries, voice commands, Ask)
OPENAI_API_KEY=

CONFERENCE_TZ=America/Denver

# Elastic platform (WS-C): Kibana for Agent Builder, Workflows, dashboards
KIBANA_URL=http://localhost:5601
# Embeddings profile for search: elser (local, default) or jina (EIS via Cloud Connect)
EMBEDDINGS=elser
# Optional overrides
# KIBANA_LLM_CONNECTOR_ID=
# JINA_INFERENCE_ID=
# JINA_RERANK_INFERENCE_ID=
